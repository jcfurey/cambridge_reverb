(footprint "TestPoint_THT_D2.0mm_Label"
  (version 20221018)
  (generator cambridge_reverb)
  (layer "F.Cu")
  (descr "Test point: 2.0 mm pad / 1.0 mm drill for a single header pin or a bare-wire loop (scope-hook friendly). The VALUE (= the net or a short alias) is printed on the front silkscreen above the pad.")
  (tags "test point TP probe")
  (attr through_hole)
  (fp_text reference "TP**" (at 0 3.2) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "TP" (at 0 -2.3) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_circle (center 0 0) (end 1.35 0) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 1.0 0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -1.6 -1.6) (end 1.6 1.6) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" thru_hole circle (at 0 0) (size 2.0 2.0) (drill 1.0) (layers "*.Cu" "*.Mask"))
)
