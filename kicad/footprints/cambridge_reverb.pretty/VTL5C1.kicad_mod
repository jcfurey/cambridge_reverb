(footprint "VTL5C1"
  (version 20221018)
  (generator cambridge_reverb)
  (layer "F.Cu")
  (descr "VTL5C1 / VTL5C2 axial vactrol (PerkinElmer-Vactec catalog p.43; Xvive remake is a drop-in), laid flat. LED leads (1 = CATHODE, marked; 2 = anode) leave one end, the photocell leads (3, 4; 5.08 mm apart) leave the other. Body 9.1-9.9 mm long x 9.4-9.9 mm wide x 7.6-8.1 mm high; LED leads up to 0.64 mm square -> 1.0 mm drill. Lead span 15.24 mm (bend >= 2.6 mm from the body). A DIY 3 mm LED + LDR pair fits the same pads.")
