	(footprint "TO-220-5_Vertical_P1.70mm_LM1875"
		(layer "F.Cu")
		(uuid "d162c495-0ce8-436e-8477-fc1c32697175")
		(at 85.6132 11.445)
		(descr "TO-220-5 inline (TI NDH0005D, LM1875T), vertical, 1.70 mm pitch. Leads 0.89x0.38 mm -> 1.1 mm drill (same as the stock KiCad TO-220-5). Pads 1.5 x 2.6 mm oval -> 0.20 mm annular ring on the 1.1 mm hole (JLCPCB absolute minimum 0.18; the 1.7 mm pitch cannot give the recommended 0.25 without a 1.0 mm drill the 0.97 mm lead diagonal would not survive), 0.20 mm pad-to-pad; to 1.45 mm (annular 0.175 mm, clears the 0.15 mm project/JLCPCB 0.13 mm minimum; stock 1.275 mm pads give only 0.0875 mm). Pad-local clearance 0.2 mm so the 0.25 mm pad gap passes DRC next to the 0.3 mm HighCurrent/Power net-class clearance.")
