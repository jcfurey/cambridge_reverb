(version 1)
# Custom DRC rules -- routing hygiene the plain net classes cannot express. Both rules
# apply to TRACKS and VIAS only, so fixed pad geometry (the LM1875's 1.7 mm pin row, the
# 0805 feedback parts, the transformer snubber caps) is not flagged; route_board.py
# gives the router the same numbers as per-class clearances in the DSN.
# 1. HighCurrent copper (PA_OUT / SPK / +33V5 / VRAW and the 24 Vrms AC1 / AC2 secondary)
#    keeps 0.6 mm from Default-class (signal) copper (1.0 mm left the router 14-27 links short): the crosstalk audit
#    (kicad/gen/crosstalk_audit.py) found PA_OUT 0.25 mm from the reverb-return trace.
(rule hc_to_signal
  (condition "(A.Type == 'Track' || A.Type == 'Via') && A.NetClass == 'HighCurrent' && B.NetClass == 'Default'")
  (constraint clearance (min 0.6mm)))
# 2. Reverb tank DRIVE (3 Vrms; class TankDrive = R_DRVO / TKDRV / TANK_IN) keeps 1.2 mm from
#    the tank RETURN path (20 mV): 11 mm parallel runs at -37 dB on the first routing.
(rule tank_drive_to_return
  (condition "(A.Type == 'Track' || A.Type == 'Via') && A.NetClass == 'TankDrive' && (B.NetName == 'TANK_OUT' || B.NetName == 'QRG' || B.NetName == 'WET' || B.NetName == 'DRVP')")
  (constraint clearance (min 1.2mm)))
